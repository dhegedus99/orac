    # Directory containing RTTOV emissivity atlas
    # https://www.nwpsaf.eu/site/software/rttov/download/
    'atlas_dir': '/usr/lib/rtcoef_rttov12/emis_data',

    # Directory of RTTOV instrument coefficient files
